// File: firestore.rules
rules_version = '2';

// Firestore security rules for Smart Cash Flow Planner
// - Owners can always read/write their own document.
// - Household members can read each other when householdId matches on both the document and the auth token.

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isHouseholdShared() {
      return isSignedIn()
        && request.auth.token.householdId != null
        && resource.data.profile.householdId != null
        && request.auth.token.householdId == resource.data.profile.householdId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isHouseholdShared();
      allow write: if isOwner(userId);
    }

    // Deny any other collection access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
