rules_version = '2';
// TODO: Align data model so that user profile contains householdId
// and auth token includes householdId custom claim.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if isUserOrSameHousehold(userId);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isUserOrSameHousehold(userId) {
      if (!isSignedIn()) return false;

      // Allow direct owner access
      if (request.auth.uid == userId) return true;

      // Allow other members in the same household based on stored profile
      // NOTE: this assumes each user doc has profile.householdId and
      // the auth token carries householdId in custom claims.
      return get(/databases/$(database)/documents/users/$(userId))
        .data.profile.householdId == request.auth.token.householdId;
    }
  }
}
